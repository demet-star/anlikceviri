{
  "name": "AnlıkÇeviri - Ekran Çevirisi",
  "short_name": "AnlıkÇeviri",
  "description": "Ekrandaki İngilizce yazıları Türkçeye çevir.",
  "lang": "tr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#171923",
  "theme_color": "#171923",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./paylas",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "resim",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}